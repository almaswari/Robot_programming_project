<?xml version="1.0"?>
<robot name="quadrotor" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:include filename="$(find quadrotor_sim)/model/robot.gazebo" />

  <!-- ROOT LINK (No base_footprint to avoid physics confusion) -->
  <link name="base_link">
    <visual>
      <geometry><box size="0.3 0.3 0.05"/></geometry> <!-- Thinner body -->
      <material name="blue"><color rgba="0 0 1 1"/></material>
    </visual>
    <collision>
      <geometry><box size="0.3 0.3 0.05"/></geometry>
    </collision>
    <inertial>
      <mass value="1.0"/> <!-- REDUCED MASS to 1.0kg -->
      <inertia ixx="0.015" ixy="0" ixz="0" iyy="0.015" iyz="0" izz="0.03"/>
    </inertial>
  </link>

  <!-- ROTOR MACRO -->
  <xacro:macro name="rotor" params="name x y dir">
    <link name="${name}_link">
      <visual>
        <geometry><cylinder radius="0.1" length="0.01"/></geometry>
        <material name="black"><color rgba="0 0 0 1"/></material>
      </visual>
      <collision>
        <geometry><cylinder radius="0.1" length="0.01"/></geometry>
      </collision>
      <inertial>
        <mass value="0.02"/> <!-- Very light rotors -->
        <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
      </inertial>
    </link>

    <joint name="${name}_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${name}_link"/>
      <origin xyz="${x} ${y} 0.04" rpy="0 0 0"/>
      <axis xyz="0 0 1"/> <!-- Axis MUST be positive Z -->
    </joint>
  </xacro:macro>

  <!-- Create 4 Rotors -->
  <xacro:rotor name="rotor_0" x="0.15" y="-0.15" dir="-1"/>
  <xacro:rotor name="rotor_1" x="-0.15" y="0.15" dir="-1"/>
  <xacro:rotor name="rotor_2" x="0.15" y="0.15" dir="1"/>
  <xacro:rotor name="rotor_3" x="-0.15" y="-0.15" dir="1"/>

  <!-- Lidar -->
  <link name="lidar_link">
    <visual>
      <geometry><cylinder radius="0.03" length="0.03"/></geometry>
    </visual>
  </link>
  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <origin xyz="0 0 0.05" rpy="0 0 0"/>
  </joint>

</robot>